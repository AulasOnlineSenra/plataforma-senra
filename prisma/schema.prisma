generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSetting {
  id                      String   @id @default("global")
  whatsapp                String   @default("")
  classValue              String   @default("50.00")
  referralBonus           String   @default("1")
  referralBonusAvulsa     String   @default("49.50")
  referralBonusEvolucao   String   @default("252.00")
  referralBonusAprovacao  String   @default("378.00")
  referralDiscountPercent String   @default("0")
  availabilityType        String   @default("weekly")
  pixKey                  String   @default("")
  pixKeyType              String   @default("cnpj")
  geminiApiKey            String?
  openaiApiKey            String?
  anthropicApiKey         String?
  openRouterApiKey        String?
  minimaxApiKey           String?
  grokApiKey              String?
  searchApiKey            String?
  backupAuto              Boolean  @default(false)
  backupFrequency         String   @default("weekly")
  backupRetention         Int      @default(5)
  backupEmail             String?
  backupDrive             String?
  contactEmail            String?  @default("contato@aos.com.br")
  contactInstagram        String?  @default("@senra.aulasonline")
  contactSite             String?  @default("www.senraaulasonline.com.br")
  updatedAt               DateTime @updatedAt

  // Configurações do Simulado ENEM Automático
  enemSimuladoEnabled     Boolean  @default(false)
  enemDia1TemplateId      String?  // ID do SimuladoTemplate para o Dia 1 (Sábado)
  enemDia2TemplateId      String?  // ID do SimuladoTemplate para o Dia 2 (Domingo)
  enemReleaseHour         Int      @default(13) // Hora de liberação (padrão 13:00)
  enemReleaseMinute       Int      @default(0)
  enemOnlyTaggedStudents  Boolean  @default(true) // Enviar apenas para alunos com tag Foco ENEM

  // Configurações do Scraper de Calendário (IA)
  scraperRequiresApproval Boolean  @default(true)
  scraperFrequency        String   @default("weekly") // "daily" | "weekly"
  scraperLastRun          DateTime?

  // Modal de Indicações
  referralModalEnabled    Boolean  @default(true)
  referralModalFrequency  String   @default("always") // "always" ou "once_per_day"
  referralModalMaxVisits  Int      @default(8)
  referralModalMaxDays    Int      @default(45)
  referralModalImages     String   @default("[]") // Lista de URLs das imagens
}

model Availability {
  id        String @id @default(cuid())
  teacherId String
  dayOfWeek Int
  startTime String
  endTime   String
  User      User   @relation(fields: [teacherId], references: [id])

  @@index([teacherId])
}

model BlogPost {
  id            String   @id @default(cuid())
  slug          String?  @unique
  title         String
  excerpt       String
  content       String
  author        String
  image         String?
  tags          String   @default("[]")
  published     Boolean  @default(false)
  status        String   @default("DRAFT")
  referenceUrl  String?
  likes         Int      @default(0)
  dislikes      Int      @default(0)
  commentsCount Int      @default(0)
  views         Int      @default(0)
  metaDescription String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ChatMessage {
  id                                String    @id @default(cuid())
  senderId                          String
  receiverId                        String
  content                           String
  createdAt                         DateTime  @default(now())
  readAt                            DateTime?
  attachmentName                    String?
  attachmentType                    String?
  attachmentUrl                     String?
  User_ChatMessage_receiverIdToUser User      @relation("ChatMessage_receiverIdToUser", fields: [receiverId], references: [id])
  User_ChatMessage_senderIdToUser   User      @relation("ChatMessage_senderIdToUser", fields: [senderId], references: [id])

  @@index([receiverId, senderId, createdAt])
  @@index([senderId, receiverId, createdAt])
}

model Lead {
  id        String   @id @default(cuid())
  name      String?
  email     String?
  createdAt DateTime @default(now())
}

model CrmBoard {
  id            String      @id @default(cuid())
  name          String
  coverColor    String?     @default("bg-gradient-to-r from-blue-500 to-cyan-500")
  isFavorite    Boolean     @default(false)
  columns       CrmColumn[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model CrmColumn {
  id        String    @id @default(cuid())
  name      String
  color     String?   @default("bg-slate-400")
  order     Int       @default(0)
  boardId   String
  board     CrmBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  leads     CrmLead[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([boardId])
}

model CrmLead {
  id          String       @id @default(cuid())
  name        String
  phone       String?
  email       String?
  source      String?
  series      String?
  tags        String?      @default("[]") // JSON array of strings
  temperature String       @default("frio") // frio, morno, quente, muito-quente
  description String?
  dueDate     DateTime?
  alarms      String?      @default("[]") // JSON array of { id, date, note, completed }
  attachments String?      @default("[]") // JSON array of links/files
  checklist   String?      @default("[]") // JSON array of { id, text, completed }
  lastContact DateTime?
  order       Int          @default(0)
  columnId    String
  column      CrmColumn    @relation(fields: [columnId], references: [id], onDelete: Cascade)
  comments    CrmComment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([columnId])
}

model CrmComment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  leadId    String
  lead      CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([leadId])
}

model Lesson {
  id                          String   @id @default(cuid())
  studentId                   String
  teacherId                   String
  subject                     String
  customTitle                 String?
  date                        DateTime
  endDate                     DateTime @default(now())
  status                      String   @default("CONFIRMED")
  meetingLink                 String?
  price                       Float?
  isExperimental              Boolean  @default(false)
  cancelReason                String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
  materials                   String?  // JSON array of material URLs
  teacher                     User     @relation("Lesson_teacherIdToUser", fields: [teacherId], references: [id])
  student                     User     @relation("Lesson_studentIdToUser", fields: [studentId], references: [id])
  Rating                      Rating[]

  @@index([studentId])
  @@index([teacherId])
  @@index([date])
  @@index([status])
  @@index([studentId, date])
  @@index([teacherId, date])
  @@index([studentId, status])
}

model MarketingCost {
  id                 String   @id @default(cuid())
  month              String   @unique
  ads                Float    @default(0)
  team               Float    @default(0)
  organicCommissions Float    @default(0)
  paidCommissions    Float    @default(0)
  updatedAt          DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  lessonsCount Int
  price        Float
  durationMins Int
  isPopular    Boolean  @default(false)
  features     String   @default("[]")  // JSON array de features
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Rating {
  id                          String   @id @default(cuid())
  studentId                   String
  teacherId                   String
  lessonId                    String?
  score                       Int
  comment                     String?
  givenBy                     String
  createdAt                   DateTime @default(now())
  Lesson                      Lesson?  @relation(fields: [lessonId], references: [id])
  User_Rating_teacherIdToUser User     @relation("Rating_teacherIdToUser", fields: [teacherId], references: [id])
  User_Rating_studentIdToUser User     @relation("Rating_studentIdToUser", fields: [studentId], references: [id])

  @@unique([studentId, teacherId, givenBy])
  @@index([studentId])
  @@index([teacherId])
  @@index([createdAt])
  @@index([studentId, createdAt])
}

model ScheduledMessage {
  id                                     String    @id @default(cuid())
  senderId                               String
  receiverId                             String
  content                                String
  scheduledAt                            DateTime
  status                                 String    @default("pending")
  createdAt                              DateTime  @default(now())
  sentAt                                 DateTime?
  attachmentUrl                          String?
  attachmentName                         String?
  attachmentType                         String?
  User_ScheduledMessage_receiverIdToUser User      @relation("ScheduledMessage_receiverIdToUser", fields: [receiverId], references: [id])
  User_ScheduledMessage_senderIdToUser   User      @relation("ScheduledMessage_senderIdToUser", fields: [senderId], references: [id])

  @@index([senderId, receiverId])
  @@index([status, scheduledAt])
}

model Simulado {
  id                            String   @id @default(cuid())
  title                         String
  description                   String
  subject                       String
  creatorId                     String
  studentId                     String
  status                        String   @default("Pendente")
  maxAttempts                   Int      @default(1)
  timeLimitMinutes              Int?
  questions                     Json
  attempts                      Json
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  User_Simulado_studentIdToUser User     @relation("Simulado_studentIdToUser", fields: [studentId], references: [id])
  User_Simulado_creatorIdToUser User     @relation("Simulado_creatorIdToUser", fields: [creatorId], references: [id])

  @@index([studentId, createdAt])
  @@index([creatorId, createdAt])
}

model Subject {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id            String   @id @default(uuid())
  studentId     String
  planName      String
  creditsAdded  Int
  amountPaid    Float
  paymentMethod String   @default("PIX")
  status        String   @default("COMPROVADO")
  createdAt     DateTime @default(now())
  proofUrl      String?
  bookings      String?
  student       User     @relation(fields: [studentId], references: [id])

  @@index([status])
  @@index([studentId])
  @@index([createdAt])
  @@index([studentId, createdAt])
}

model SimuladoTemplate {
  id               String   @id @default(cuid())
  title            String
  description      String   @default("")
  subject          String   @default("ENEM")
  dayType          String   @default("DIA1") // "DIA1" | "DIA2" | "CUSTOM"
  timeLimitMinutes Int?     // Dia1=330 (5h30), Dia2=300 (5h)
  questions        Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model User {
  id                                                 String             @id @default(cuid())
  name                                               String
  email                                              String             @unique
  password                                           String
  role                                               String             @default("student")
  avatarUrl                                          String?
  status                                             String             @default("active")
  referralCode                                       String             @unique
  referredById                                       String?
  resetToken                                         String?
  resetTokenExpiry                                   DateTime?
  credits                                            Int                @default(0)
  createdAt                                          DateTime           @default(now())
  updatedAt                                          DateTime           @updatedAt
  subject                                            String?
  cpf                                                String?            @unique
  birthDate                                          DateTime?
  cep                                                String?
  state                                              String?
  neighborhood                                       String?
  street                                             String?
  number                                             String?
  videoUrl                                           String?
  isValidated                                        Boolean            @default(false)
  bio                                                String?
  education                                          String?
  pixKey                                             String?
  pixKeyType                                         String?
  subjects                                           String?
  tags                                               String?            @default("[]") // JSON array, ex: ["Foco ENEM"]
  autoSchedule                                       Boolean            @default(false)
  suspendedAt                                        DateTime?
  phone                                              String?
  googleCalendarConnected                            Boolean            @default(false)
  googleCalendarToken                                String?
  googleCalendarRefreshToken                         String?
  googleCalendarEmail                                String?
  googleCalendarTokenExpiry                          DateTime?
  failedLoginAttempts                                Int                @default(0)
  lastFailedLogin                                    DateTime?
  usedReferralDiscount                               Boolean            @default(false)
  Availability                                       Availability[]
  ChatMessage_ChatMessage_receiverIdToUser           ChatMessage[]      @relation("ChatMessage_receiverIdToUser")
  ChatMessage_ChatMessage_senderIdToUser             ChatMessage[]      @relation("ChatMessage_senderIdToUser")
  teacherLessons                                     Lesson[]           @relation("Lesson_teacherIdToUser")
  studentLessons                                     Lesson[]           @relation("Lesson_studentIdToUser")
  Notification                                       Notification[]
  Rating_Rating_teacherIdToUser                      Rating[]           @relation("Rating_teacherIdToUser")
  Rating_Rating_studentIdToUser                      Rating[]           @relation("Rating_studentIdToUser")
  ScheduledMessage_ScheduledMessage_receiverIdToUser ScheduledMessage[] @relation("ScheduledMessage_receiverIdToUser")
  ScheduledMessage_ScheduledMessage_senderIdToUser   ScheduledMessage[] @relation("ScheduledMessage_senderIdToUser")
  Simulado_Simulado_studentIdToUser                  Simulado[]         @relation("Simulado_studentIdToUser")
  Simulado_Simulado_creatorIdToUser                  Simulado[]         @relation("Simulado_creatorIdToUser")
  Transaction                                        Transaction[]
  questionsCreated                                   Question[]         @relation("Question_creatorIdToUser")
  User                                               User?              @relation("UserToUser", fields: [referredById], references: [id])
  other_User                                         User[]             @relation("UserToUser")
}

model QuizQuestion {
  id          String   @id @default(cuid())
  question    String
  questionPt  String?
  type        String   @default("text")
  options     String?  @default("[]")
  placeholder String?
  isRequired  Boolean  @default(false)
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiAgent {
  id           String   @id @default(cuid())
  name         String
  description  String?
  instructions String?
  model        String   @default("gemini-2.0-flash")
  tools        String?  @default("[]") // JSON array of enabled tool IDs
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PageVisit {
  id        String   @id @default(cuid())
  url       String
  userId    String?
  device    String   @default("Desktop")
  source    String?
  timeSpent Int      @default(0)
  createdAt DateTime @default(now())

  @@index([url])
  @@index([createdAt])
}

model CrmChecklistTemplate {
  id        String   @id @default(cuid())
  name      String
  items     String   @default("[]") // JSON array of texts
  createdAt DateTime @default(now())
}

model ScheduleStructure {
  id        String   @id @default(cuid())
  userId    String
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, etc.
  startTime String   // e.g., "07:00"
  endTime   String   // e.g., "08:30"
  subject   String
  teacherId String?
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Question {
  id                  String   @id @default(cuid())
  title               String?
  discipline          String   // e.g., "matematica", "linguagens", "humanas", "natureza"
  subject             String   // e.g., "Funções", "Termodinâmica"
  difficulty          String   @default("Médio") // Fácil, Médio, Difícil
  context             String   // Texto de apoio/enunciado
  files               String   @default("[]") // JSON string list of supporting image URLs
  correctAlternative  String   // Letra da alternativa correta (A, B, C, D, E)
  alternatives        Json     // List of alternatives [{ letter, text, file }]
  creatorId           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  creator             User     @relation("Question_creatorIdToUser", fields: [creatorId], references: [id])

  @@index([creatorId])
  @@index([discipline])
}

model ReferenceBlog {
  id        String   @id @default(cuid())
  name      String
  url       String
  feedUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vestibular {
  id               String            @id @default(cuid())
  name             String            @default("")
  institution      String
  state            String            @default("Nacional")
  type             String            @default("Vestibular")
  officialSite     String?
  isActive         Boolean           @default(true)
  scrapingUrl      String?
  lastScrapeStatus String?
  lastScrapeDate   DateTime?
  events           VestibularEvent[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([state])
  @@index([type])
  @@index([isActive])
}

model VestibularEvent {
  id           String     @id @default(cuid())
  vestibularId String
  vestibular   Vestibular @relation(fields: [vestibularId], references: [id], onDelete: Cascade)
  type         String
  dateStart    DateTime
  dateEnd      DateTime?
  description  String?
  status       String     @default("APPROVED")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([vestibularId])
  @@index([type])
  @@index([dateStart])
}

model AiAgent {
  id           String   @id @default(cuid())
  name         String
  description  String?
  instructions String?  @db.Text
  model        String?  @default("gemini-3.6-flash")
  tools        String?  @db.Text
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
